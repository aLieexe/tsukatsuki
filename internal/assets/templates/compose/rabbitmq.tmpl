rabbitmq:
    image: {{ .DockerImage }}
    container_name: {{ .ProjectName }}_rabbitmq
    restart: always 
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
      - rabbitmq_log:/var/log/rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3