caddy: 
    image: {{ .DockerImage }} 
    container_name: caddy-proxy
    restart: unless-stopped
    ports:
    - "80:80"
    - "443:443"
    volumes:
    - ./Caddyfile:/etc/caddy/Caddyfile
    - ./project:/etc/caddy/sites
    - caddy_data:/data
    - caddy_config:/config
    networks:
    - proxy_network