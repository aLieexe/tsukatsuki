minio:
    image: {{ .DockerImage }}
    container_name: {{ .ProjectName }}_minio
    restart: always 
    volumes:
      - minio_data:/data
    command: server /data --console-address ":9001"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 30s
      timeout: 10s
      retries: 3