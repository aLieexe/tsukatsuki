services:
{{range .Service}}  {{.}}
    networks:
    - {{ $.ProjectName }}_network

{{end}}
  {{.ProjectName}}:
    image: {{ .ProjectName }}:latest
    container_name: {{ .ProjectName }}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ .AppPort }}/"]
      interval: 10s
      timeout: 3s
      retries: 3
    networks:
    - proxy_network
    - {{ .ProjectName }}_network
{{- if eq .Proxy "traefik" }}
    labels:
    - "traefik.enable=true"
    - "traefik.http.routers.app.rule=Host(`{{ .AppSiteAddress }}`)"
    - "traefik.http.routers.app.entrypoints=websecure"
    - "traefik.http.routers.app.tls.certresolver=mytlschallenge"
    - "traefik.http.services.app.loadbalancer.server.port=5500"
{{- end }}

{{- if .Volumes }}
volumes:
{{- range .Volumes }}
  {{ . }}:
{{- end }}
{{- end }}

networks:
  proxy_network:
    external: true

  {{ .ProjectName }}_network:
    driver: bridge
    internal: true # blocks all external access

